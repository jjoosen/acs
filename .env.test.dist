# Sjabloon voor de server-`.env.local` van de TESTOMGEVING.
# Kopieer naar $DEPLOY_PATH/shared/.env.local en vul in (NIET in git).

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=CHANGE_ME_32_HEX

# Database (ORM). Eigen test-DB.
DATABASE_URL="mysql://USER:PASS@127.0.0.1:3306/acs_test?serverVersion=8.0"

# PHPCR-transport: doctrinedbal (in MySQL, geen Java) of jackrabbit.
# Bij jackrabbit: ook de Jackrabbit-URL configureren in config/packages/.
SULU_PHPCR_TRANSPORT=doctrinedbal

# Mail (formulieren).
MAILER_DSN=smtp://USER:PASS@smtp.host:587

# Externe keys (uit oude .env): Google Maps, reCAPTCHA, Sentry.
# GOOGLE_MAPS_API_KEY=
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET=
# SENTRY_DSN=
