{% if block is defined %}
    {% set title = block.field('title') %}
    {% set title_size = block.field('title_size') %}
    {% set text = block.field('text') %}
    {% set dropdown = "" %}

    {% for tag in page.tags.all %}
        {% if not loop.first %}
            {% set dropdown = dropdown ~ "," %}
        {% endif %}
        {% set dropdown = dropdown ~ tag.name %}
    {% endfor %}
    {% set block_id = block.id %}
{% endif %}

<div id="block-{{ block_id }}" class="bg-secondary-light pb-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 my-3 my-lg-4 text-center">
                {% if title %}
                    <h{{ title_size|default(2) }} class="h2 mb-0">{{ title }}</h{{ title_size|default(2) }}>
                {% endif %}

                {% if text %}
                    <div class="text text-primary">
                        {{ text|raw }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="container mb-4 mb-lg-6 mt--100px">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="bg-white rounded box-shadow p-1 p-sm-3">
                {% set inactive = page.fields.inactive|default %}

                {% if inactive %}
                    <div class="alert alert-warning mb-0">
                        {{ 'job_inactive_message_form'|trans }}
                    </div>
                {% else %}
                    {{ get_form_by_tag('job', null, false, hiddenFields = {'Vacature': page.name}, hiddenFieldsForConfirmation = {'locations': dropdown}) }}
                {% endif %}
            </div>
        </div>
    </div>
</div>
