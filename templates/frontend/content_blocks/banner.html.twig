{% if block is defined %}
    {% set title = block.field('title') %}
    {% set text = block.field('text') %}
    {% set height = block.field('height') ?: 'py-3 py-lg-6' %}
    {% set text_size = block.field('text_size') ?: '' %}
    {% set image = block.assets.firstOfType('image') %}
    {% set nomb = block.field('no_bottom_margin'|default(false)) %}
    {% set block_id = block.id %}
{% endif %}

<div id="block-{{ block_id }}" class="banner position-relative {% if nomb == true %} mb-0 {% else %} {{margin_bottom()}} {% endif %}">
    <div class="background-cover background-center background-fixed position-absolute h-100 w-100 filter-contrast-60 {% if not image %}bg-secondary-light{% endif %}"
         {% if image %}style="background-image: linear-gradient(0deg, rgba(81, 136, 250, 0.55), rgba(81, 136, 250, 0.55)), url({{ img(image.getFilename(), 1440, 640) }})"{% endif %}></div>
    <div class="container">
        <div class="row justify-content-center text-center {% if image %}text-white{% endif%} {{ height }}">
            <div class="{% if text_size == 'big-text' %} col-lg-9  {% else %} col-md-8 col-lg-6  {% endif %}">
                {% if title %}
                    <h2 class="banner__title {% if image %}text-white{% endif%}">{{ title }}</h2>
                {% endif %}

                {% if text %}
                    <div class="text {{ text_size }}">
                        {{ text|raw }}
                    </div>
                {% endif %}
                {% include '/frontend/content_blocks/partials/_buttons.html.twig' %}
            </div>
        </div>
    </div>
</div>
