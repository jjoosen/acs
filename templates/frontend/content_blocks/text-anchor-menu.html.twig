{% if block is defined %}
    {% set anchor_items = block.children %}
    {% set urlReplacements = {' & ': '-', ' ': '-','|': ''} %}
    {% set block_id = block.id %}
{% endif %}

{% import 'frontend/macros/images.html.twig' as img_macro %}

<div id="block-{{ block_id }}" class="container {{ margin_bottom() }}">
    <div class="row">
        <div class="col-3 d-none d-lg-block">
            <ul class="side-menu side-menu--sticky list-unstyled mt-2 mt-lg-3 mb-4">
                {% for item in anchor_items %}
                    {% set title = item.field('title') %}
                    {% set id = title|lower|replace(urlReplacements) %}

                    <li class="side-menu__item js-side-menu-item" data-item="{{ id }}">
                        <a class="side-menu__link" href="#{{ id }}">{{ title }}</a>
                    </li>
                {% endfor %}
            </ul>
        </div>

        <div class="col-lg-9 col-xl-8">
            {% for item in anchor_items %}
                {% set title = item.field('title') %}
                {% set id = title|lower|replace(urlReplacements) %}
                {% set text = item.field('text') %}
                {% set image = item.assets.firstOfType('image') %}

                <div id="{{ id }}" class="border-bottom py-2 py-lg-3 js-anchor-item">
                    {% if loop.first %}
                        <h1 class="text-primary">{{ title }}</h1>
                    {% else %}
                        <h2>{{ title }}</h2>
                    {% endif %}

                    {% if text %}
                        <div class="text">
                            {{ text|raw }}
                        </div>
                    {% endif %}

                    {% if image %}
                        {{ img_macro.picture(image, 650, 430, 'fill', 'smart', 85, 'mt-3 mw-100') }}
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</div>
