{# Sulu block: image — geport van legacy content_blocks/image.html.twig #}
{% set image = (block.image|default([]))|first %}
{% set src = image ? img(image, 1400, 600) : (block_images(block.legacy_id|default(''))|first|default('')) %}
{% if src %}
    {% if block.compact|default(false) %}
        <div class="container">
            <div class="row">
                <div class="col-12 default-image py-4">
                    <img class="img-fluid" src="{{ src }}" alt="{{ block.title|default('') }}" loading="lazy">
                </div>
            </div>
        </div>
    {% else %}
        <img class="w-100" src="{{ src }}" alt="{{ block.title|default('') }}" loading="lazy">
    {% endif %}
{% endif %}
