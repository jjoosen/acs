{# Sulu block: video — geport van legacy content_blocks/video.html.twig #}
{% set image = (block.image|default([]))|first %}
{% set src = image ? img(image, 1600, 900, 'fit') : (block_images(block.legacy_id|default(''))|first|default('')) %}
{% set youtube_id = block.youtube_id|default('') %}
<div class="container mb-6">
    <div class="row text-center justify-content-center">
        <div class="col-md-10 col-lg-8 my-3 my-lg-4">
            {% if block.title|default %}
                {% set hs = block.title_size|default(2) %}
                <h{{ hs }} class="h2">{{ block.title }}</h{{ hs }}>
            {% endif %}
            {% if block.text|default %}<div class="text text-primary">{{ block.text|raw }}</div>{% endif %}
        </div>
        <div class="col-12">
            {% if youtube_id %}
                <div class="embed-responsive embed-responsive-16by9 rounded box-shadow">
                    <iframe class="embed-responsive-item" allowfullscreen
                            allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                            src="https://www.youtube.com/embed/{{ youtube_id }}?enablejsapi=1"></iframe>
                </div>
            {% elseif src %}
                <img class="rounded box-shadow w-100" src="{{ src }}" alt="{{ block.title|default('') }}" loading="lazy">
            {% endif %}
        </div>
    </div>
</div>
