{# Sulu block: summary (stappenplan) — geport van content_blocks/summary.html.twig #}
{% set items = block.items|default([]) %}
<div id="block-{{ block.legacy_id|default('') }}" class="container {{ margin_bottom() }}">
    {% if block.title|default %}<h2 class="text-center mb-4">{{ block.title }}</h2>{% endif %}
    <div>
        {% for item in items %}
            <div class="row px-3 px-lg-4 px-xl-5 justify-content-center">
                <div class="col-lg-1 mb-3 d-flex justify-content-center d-lg-block">
                    <div class="summary__dot d-flex align-items-center justify-content-center">{{ loop.index }}</div>
                </div>
                {% if item.text|default %}
                    <div class="col-lg-11 mb-3 px-2"><div class="text">{{ item.text|raw }}</div></div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>
