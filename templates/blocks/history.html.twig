{# Sulu block: history (tijdlijn) — geport van content_blocks/history.html.twig #}
{% set items = block.items|default([]) %}
<div id="block-{{ block.legacy_id|default('') }}" class="text-element-bg">
    <div class="container {{ margin_bottom() }}">
        <div class="row">
            <div class="col-12 mt-3">
                {% if block.title|default %}<h{{ block.title_size|default(2) }}>{{ block.title }}</h{{ block.title_size|default(2) }}>{% endif %}
                {% if block.text|default %}<div class="text">{{ block.text|raw }}</div>{% endif %}
            </div>
        </div>
        <div class="timeline">
            <div class="timeline__line"></div>
            {% for item in items %}
                <div class="row timeline__row {% if loop.index is even %}justify-content-end{% else %}justify-content-start{% endif %}">
                    <div class="timeline__dot"></div>
                    <div class="col-11 col-lg-5 box-shadow rounded p-3">
                        <p class="h3 d-flex flex-row align-center mb-2">{{ item.title|default('') }}</p>
                        {% if item.text|default %}<div class="text">{{ item.text|raw }}</div>{% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
