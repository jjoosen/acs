{# Sulu block: text_card — geport van legacy content_blocks/text_card.html.twig #}
{% set image = (block.image|default([]))|first %}
<div class="container {{ margin_bottom() }}">
    {% if block.title|default %}
        {% set hs = block.title_size|default(2) %}
        <div class="row mb-2"><div class="col-12"><h{{ hs }} class="mb-0">{{ block.title }}</h{{ hs }}></div></div>
    {% endif %}
    <div class="row box-shadow p-2 align-items-center rounded no-gutters">
        <div class="col-md-9 col-lg-8 p-10px order-1 order-md-0">
            {% if block.text|default %}<div class="text font-size-18">{{ block.text|raw }}</div>{% endif %}
        </div>
        {% if image %}
            <div class="col-md-3 offset-lg-1 text-md-center">
                <img class="mw-100" src="{{ img(image, 178, 33, 'fit') }}" alt="{{ image.title }}" loading="lazy">
            </div>
        {% endif %}
    </div>
</div>
