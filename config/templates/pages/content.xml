                    <property name="image" type="media_selection">
                        <meta><title lang="nl">Poster/afbeelding</title></meta>
                        <params><param name="types" value="image"/></params>
                    </property>
                </properties>
            </type>

            <!-- ====== google_maps ====== -->
            <type name="google_maps">
                <meta><title lang="nl">Google Maps</title></meta>
                <properties>
                    <property name="legacy_id" type="text_line"/>
                    <property name="iframe" type="text_area"><meta><title lang="nl">Iframe-URL</title></meta></property>
                </properties>
            </type>

            <!-- ====== code ====== -->
            <type name="code">
                <meta><title lang="nl">Code / HTML</title></meta>
                <properties>
                    <property name="legacy_id" type="text_line"/>
                    <property name="code" type="text_area"><meta><title lang="nl">Code</title></meta></property>
                </properties>
            </type>

            <!-- ====== text_menu ====== -->
            <type name="text_menu">
                <meta><title lang="nl">Tekst met menu</title></meta>
                <properties>
                    <property name="legacy_id" type="text_line"/>
                    <property name="title" type="text_line"><meta><title lang="nl">Titel</title></meta></property>
                    <property name="text" type="text_editor"><meta><title lang="nl">Tekst</title></meta></property>
                </properties>
            </type>

            <!-- ====== toggle_list (accordion/FAQ) ====== -->
            <type name="toggle_list">
                <meta><title lang="nl">Uitklaplijst</title></meta>
                <properties>
                    <property name="legacy_id" type="text_line"/>
                    <property name="title" type="text_line"><meta><title lang="nl">Titel</title></meta></property>
                    <property name="no_bottom_margin" type="checkbox"><meta><title lang="nl">Geen ondermarge</title></meta></property>
                    <block name="items" default-type="toggle_item" minOccurs="0">
                        <meta><title lang="nl">Items</title></meta>
                        <types>
                            <type name="toggle_item">
                                <meta><title lang="nl">Item</title></meta>
                                <properties>
                                    <property name="legacy_id" type="text_line"/>
                                    <property name="title" type="text_line"><meta><title lang="nl">Vraag</title></meta></property>
                                    <property name="text" type="text_editor"><meta><title lang="nl">Antwoord</title></meta></property>
                                </properties>
                            </type>
                        </types>
                    </block>
                </properties>
            </type>

            <!-- ====== cards_list ====== -->
            <type name="cards_list">
                <meta><title lang="nl">Kaarten</title></meta>
                <properties>
                    <property name="legacy_id" type="text_line"/>
                    <property name="title" type="text_line"><meta><title lang="nl">Titel</title></meta></property>
                    <property name="text" type="text_editor"><meta><title lang="nl">Tekst</title></meta></property>
                    <block name="cards" default-type="card" minOccurs="0">
                        <meta><title lang="nl">Kaarten</title></meta>
                        <types>
                            <type name="card">
                                <meta><title lang="nl">Kaart</title></meta>
                                <properties>
                                    <property name="legacy_id" type="text_line"/>
                                    <property name="title" type="text_line"><meta><title lang="nl">Titel</title></meta></property>
                                    <property name="text" type="text_editor"><meta><title lang="nl">Tekst</title></meta></property>
                                    <property name="link" type="text_line"><meta><title lang="nl">Link</title></meta></property>
                                </properties>
                            </type>
                        </types>
                    </block>
                </properties>
            </type>

            <!-- ====== cards_list_four ====== -->
            <type name="cards_list_four">
                <meta><title lang="nl">Kaarten (vier)</title></meta>
                <properties>
                    <property name="legacy_id" type="text_line"/>
                    <property name="title" type="text_line"><meta><title lang="nl">Titel</title></meta></property>
                    <property name="text" type="text_editor"><meta><title lang="nl">Tekst</title></meta></property>
                    <block name="cards" default-type="card_four" minOccurs="0">
