                                    <property name="title" type="text_line"><meta><title lang="nl">Titel</title></meta></property>
                                    <property name="text" type="text_editor"><meta><title lang="nl">Tekst</title></meta></property>
                                    <property name="button_link" type="text_line"><meta><title lang="nl">Knop-link</title></meta></property>
                                    <property name="button_title" type="text_line"><meta><title lang="nl">Knop-tekst</title></meta></property>
                                    <property name="button_type" type="text_line"><meta><title lang="nl">Knop-type</title></meta></property>
                                </properties>
                            </type>
                        </types>
                    </block>
                </properties>
            </type>

            <!-- ====== cards_with_button ====== -->
            <type name="cards_with_button">
                <meta><title lang="nl">Kaarten met knop</title></meta>
                <properties>
                    <property name="legacy_id" type="text_line"/>
                    <block name="cards" default-type="card_button" minOccurs="0">
                        <meta><title lang="nl">Kaarten</title></meta>
                        <types>
                            <type name="card_button">
                                <meta><title lang="nl">Kaart</title></meta>
                                <properties>
                                    <property name="legacy_id" type="text_line"/>
                                    <property name="title" type="text_line"><meta><title lang="nl">Titel</title></meta></property>
                                    <property name="text" type="text_editor"><meta><title lang="nl">Tekst</title></meta></property>
                                    <property name="text_small" type="text_line"><meta><title lang="nl">Kleine tekst</title></meta></property>
                                    <property name="link" type="text_line"><meta><title lang="nl">Link</title></meta></property>
                                    <property name="link_text" type="text_line"><meta><title lang="nl">Linktekst</title></meta></property>
                                </properties>
                            </type>
                        </types>
                    </block>
                </properties>
            </type>

            <!-- ====== cards_with_icon ====== -->
            <type name="cards_with_icon">
                <meta><title lang="nl">Kaarten met icoon</title></meta>
                <properties>
                    <property name="legacy_id" type="text_line"/>
                    <property name="title" type="text_line"><meta><title lang="nl">Titel</title></meta></property>
                    <property name="link" type="text_line"><meta><title lang="nl">Link</title></meta></property>
                    <property name="link_text" type="text_line"><meta><title lang="nl">Linktekst</title></meta></property>
                    <block name="cards" default-type="card_icon" minOccurs="0">
                        <meta><title lang="nl">Kaarten</title></meta>
                        <types>
