# Voorbeeld nginx-vhost voor de Sulu-testomgeving.
# Wijs document root naar de 'current' release-symlink.

server {
    listen 80;
    server_name test.acs.be;          # pas aan
    root /data/sites/.../testing/current/public;   # = DEPLOY_PATH/current/public

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location ~ ^/index\.php(/|$) {
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;   # pas aan
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        internal;
    }

    # Statische assets direct serveren.
    location ~* \.(?:css|js|woff2?|ttf|eot|svg|png|jpe?g|gif|ico|webp)$ {
        expires 7d;
        try_files $uri =404;
    }

    location ~ \.php$ { return 404; }   # geen andere php-scripts

    client_max_body_size 64m;           # uploads
}
