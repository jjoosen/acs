<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>caresse_home</key>

    <view>pages/caresse_home</view>
    <controller>Sulu\Bundle\WebsiteBundle\Controller\DefaultController::indexAction</controller>
    <cacheLifetime>60</cacheLifetime>

    <meta>
        <title lang="nl">Homepagina</title>
    </meta>

    <properties>
        <property name="title" type="text_line" mandatory="true">
            <meta><title lang="nl">Titel</title></meta>
            <tag name="sulu.rlp.part"/>
        </property>
        <property name="url" type="resource_locator" mandatory="true">
            <meta><title lang="nl">Adres</title></meta>
            <tag name="sulu.rlp"/>
        </property>

        <property name="subtitle" type="text_line">
            <meta><title lang="nl">Subtitel (hero)</title></meta>
        </property>
        <property name="phone_display" type="text_line">
            <meta><title lang="nl">Telefoon (tonen)</title></meta>
        </property>
        <property name="phone_link" type="text_line">
            <meta><title lang="nl">Telefoon (link, bv. 003234751924)</title></meta>
        </property>
        <property name="email" type="text_line">
            <meta><title lang="nl">E-mailadres</title></meta>
        </property>
        <property name="facebook_url" type="text_line">
            <meta><title lang="nl">Facebook-URL</title></meta>
        </property>
        <property name="webshop_url" type="text_line">
            <meta><title lang="nl">Webshop-URL</title></meta>
        </property>
        <property name="address" type="text_editor">
            <meta><title lang="nl">Adres</title></meta>
        </property>
        <property name="opening_hours" type="text_editor">
            <meta><title lang="nl">Openingsuren</title></meta>
        </property>
        <property name="privacy_policy" type="text_editor">
            <meta><title lang="nl">Privacy policy</title></meta>
        </property>
        <property name="cookie_policy" type="text_editor">
            <meta><title lang="nl">Cookie policy</title></meta>
        </property>
    </properties>
</template>
